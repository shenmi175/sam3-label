COMPOSE_PROJECT_NAME=sam3-auto-label
SAM3_DEPLOY_PROFILE=gpu

# Direct IP:port access to web-auto.
WEB_AUTO_HTTP_BIND=0.0.0.0
WEB_AUTO_HTTP_PORT=8000

TZ=Asia/Shanghai

# Required internal token shared by web-auto and sam3-api.
# Generate one before first startup:
#   openssl rand -hex 32
SAM3_API_TOKEN=
SAPIENS_API_TOKEN=
OPS_API_TOKEN=
LOCATE_API_TOKEN=
OPS_ALLOWED_SERVICES=sam3-api,locate-anything-api,sapiens-api
# Service-control and log-download permissions are intentionally separate.
OPS_CONTROLLABLE_SERVICES=sam3-api,locate-anything-api,sapiens-api
OPS_LOGGABLE_SERVICES=ops-api,web-auto,task-worker,sam3-api,locate-anything-api,sapiens-api
OPS_HOST_PROJECT_ROOT=

# Persistent host directories.
WEB_AUTO_DATA_DIR=./web-auto/data
SAM3_API_DATA_DIR=./sam3-api/data
SAM3_CHECKPOINT_DIR=./sam3_checkpoints
SAPIENS_API_DATA_DIR=./sapiens-api/data
SAPIENS_CHECKPOINT_ROOT=./sapiens_checkpoints
LOCATE_CHECKPOINT_DIR=./locate_checkpoints

# Mount this host path at the same absolute path inside web-auto.
# deploy.sh writes absolute defaults. Use an external disk path here when needed.
WEB_AUTO_HOST_DATA_ROOT=
WEB_AUTO_ALLOWED_DATA_ROOTS=
WEB_AUTO_DEFAULT_UPLOAD_TARGET_DIR=

# SAM3 runtime.
SAM3_API_DEVICE=cuda
SAM3_GPU_DEVICE_ID=1
SAM3_API_LOAD_FROM_HF=0
# 启动即加载模型并校验（fail-fast，加载失败容器退出）。置 0 回退懒加载。
# 旧名 SAM3_API_WARMUP_ON_START 仍兼容。
SAM3_API_EAGER_LOAD=1
SAM3_API_MAX_BATCH_FILES=32
SAM3_API_ENABLE_INSTANCE_INTERACTIVITY=1
SAM3_API_FEATURE_GPU_LRU_SIZE=5
SAM3_API_FEATURE_WRITE_WORKERS=2
SAM3_API_FEATURE_WRITE_MAX_PENDING=32
SAM3_API_FEATURE_FORMAT_VERSION=sam3-inst-v1
WEB_AUTO_LOG_MAX_BYTES=5242880
WEB_AUTO_LOG_FILE_COUNT=3
WEB_AUTO_EVENT_LOG_MAX_BYTES=5242880
WEB_AUTO_EVENT_LOG_FILE_COUNT=3
SAM3_API_SHM_SIZE=8gb

# Official SAM3 README currently recommends PyTorch 2.10.0 with CUDA 12.8.
SAM3_API_BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime

# Optional Sapiens2 segmentation service. Enable with:
#   ./deploy.sh sapiens enable
SAPIENS_ENABLED=0
SAPIENS_MODEL_NAME=sapiens2_5b
SAPIENS_DEVICE=cuda:0
SAPIENS_GPU_DEVICE_ID=0
# 启动即加载模型并校验（fail-fast）。权重缺失时默认降级存活（可用下载接口补权重）；
# 设 SAPIENS_STRICT_EAGER_LOAD=1 则权重缺失也退出。
SAPIENS_EAGER_LOAD=1
SAPIENS_API_SHM_SIZE=8gb
SAPIENS_API_BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime

# Optional LocateAnything detection service. Enable with:
#   set LOCATE_ENABLED=1 in .env, then restart
LOCATE_ENABLED=0
LOCATE_GPU_DEVICE_ID=2
LOCATE_ATTN_BACKEND=la_flash
# 启动即加载模型并校验（fail-fast）。置 0 回退懒加载。旧名 LOCATE_WARMUP_ON_START 仍兼容。
LOCATE_EAGER_LOAD=1
# HuggingFace mirror for regions with restricted access to huggingface.co.
# Set to https://hf-mirror.com or a local HF proxy when downloads fail.
HF_ENDPOINT=

WEB_AUTO_ALLOW_ORIGINS=*
WEB_AUTO_SAM3_MAX_BATCH_FILES=32
WEB_AUTO_WORKER_BATCH_SLICE=4
# 智能筛选回滚快照最多保留次数和最长保留天数；任一阈值超出即清理。
WEB_AUTO_SMART_FILTER_RETENTION_MAX_RUNS=10
WEB_AUTO_SMART_FILTER_RETENTION_DAYS=30
WEB_AUTO_AUTH_ENABLED=1
WEB_AUTO_SESSION_TTL_SECONDS=43200
WEB_AUTO_ADMIN_USERNAME=admin
WEB_AUTO_ADMIN_PASSWORD=

# Run web-auto/task-worker containers as this UID:GID so volume-mounted
# files are owned by the host user. Defaults to 1000:1000.
WEB_AUTO_UID=1000
WEB_AUTO_GID=1000
