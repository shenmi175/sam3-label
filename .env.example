COMPOSE_PROJECT_NAME=sam3-auto-label
SAM3_DEPLOY_PROFILE=gpu

# Public domain and HTTPS reverse proxy exposed by Caddy.
# PUBLIC_DOMAIN must resolve to this server before deployment.
PUBLIC_DOMAIN=
ACME_EMAIL=
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_BIND=0.0.0.0
CADDY_HTTPS_PORT=443
CADDY_IMAGE_TAG=2.11.2-alpine
TZ=Asia/Shanghai

# Required internal token shared by web-auto and sam3-api.
# Generate one before first startup:
#   openssl rand -hex 32
SAM3_API_TOKEN=

# Persistent host directories.
WEB_AUTO_DATA_DIR=./web-auto/data
SAM3_API_DATA_DIR=./sam3-api/data
SAM3_CHECKPOINT_DIR=./sam3_checkpoints

# Mount this host path at the same absolute path inside web-auto.
# Keep it broad enough to cover your image/video datasets and existing project paths.
WEB_AUTO_HOST_DATA_ROOT=/home/zmb

# SAM3 runtime.
SAM3_API_DEVICE=cuda
SAM3_API_LOAD_FROM_HF=0
SAM3_API_WARMUP_ON_START=0
SAM3_API_MAX_BATCH_FILES=32
SAM3_API_SHM_SIZE=8gb

# Override if your CUDA/PyTorch base image needs to match the host driver.
SAM3_API_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WEB_AUTO_ALLOW_ORIGINS=*
WEB_AUTO_SAM3_MAX_BATCH_FILES=32
WEB_AUTO_AUTH_ENABLED=1
WEB_AUTO_SESSION_TTL_SECONDS=43200
WEB_AUTO_ADMIN_USERNAME=admin
WEB_AUTO_ADMIN_PASSWORD=
